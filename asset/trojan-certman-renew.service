[Unit]
Description=Renew and atomically deploy the personal Trojan certificate
After=network-online.target xray.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/trojan-certman renew
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/xray /etc/trojan-certman-v3 /var/lib/trojan-certman-v3 /run/lock /root/.acme.sh
